{
  "hosting": {
    "site": "remidsp-maine",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "_comment": [
          "Cross-origin isolation is scoped to the RIG DOCUMENT, not to '**'.",
          "It is the document that needs it — the NAM wasm is a pthread /",
          "SharedArrayBuffer build — and same-origin subresources need no CORP",
          "of their own, so nothing is lost by narrowing it.",
          "It matters that /signin.html is excluded: under require-corp every",
          "document in the frame tree must carry its own compatible COEP, and",
          "Firebase's auth helper at /__/auth/iframe carries none. Hosting",
          "serves that path from a reserved namespace no header rule can",
          "touch, so the helper can only ever load on a page that is not",
          "isolated. That page is /signin.html."
        ],
        "source": "/",
        "headers": [
          { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
          { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
          { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400, stale-while-revalidate=604800"
          }
        ]
      },
      {
        "source": "/t3k-wasm-module.*",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400, stale-while-revalidate=604800"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}