{
  "hosting": {
    "_comment": [
      "TEMPORARY holding configuration — this branch (maintenance-holding)",
      "serves a single 'new version on its way' page while the next Maine",
      "is built. Every path rewrites to it. To restore the real site:",
      "checkout main and `npm run deploy`."
    ],
    "site": "remidsp-maine",
    "public": "holding",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [{ "source": "**", "destination": "/index.html" }],
    "headers": [
      {
        "_comment": [
          "no-cache on everything so the holding page shows immediately and",
          "the real site comes back immediately when main is redeployed."
        ],
        "source": "**",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
