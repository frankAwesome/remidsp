rules_version = '2';

// ⚠️  THIS FILE IS THE WHOLE PROJECT'S RULES, NOT JUST THIS SITE'S.
//
// remidsp-98208 is shared: the analytics collections below belong to
// remidsp.com, and the social collections further down (profiles, posts, dms,
// messages, presets, likes, comments, …) belong to the other app on this
// project. Firestore has ONE ruleset per project — deploying replaces
// everything, it does not merge.
//
// On 2026-08-09 a deploy from the other side overwrote the `public/summary`
// rule and the metrics dashboard went dark with "insufficient permissions".
// The same mistake in the other direction would take that app's data offline.
//
// So: before `firebase deploy --only firestore:rules`, pull the live ruleset
// and diff it against this file. If they differ, someone else deployed and
// this copy is stale — merge, don't overwrite.
//
//   firebase firestore:rules get      # or the Rules tab in the console
//

// REMI DSP — analytics rules
//
// The browser writes these collections unauthenticated, so the rules are the
// only thing standing between a public endpoint and someone scripting your
// bill upward. Posture: create-only, KEY-PINNED (every field the client can
// send is enumerated; anything else is rejected), size-capped.
//
// Reading is allowed for exactly one signed-in Google account — the dashboard
// reads live rather than through a build step. See dashboardReader() below.
// Unauthenticated reads are refused, so the public API key grants nothing.
// Correcting or deleting an event is still console / Admin SDK work.
//
// These rules mirror js/analytics.js envelope() EXACTLY. If you add a field
// there, add it here in the same commit or the write silently fails — send()
// swallows errors by design (a metric must never break the page).
//
// Pair with App Check *enforced* (Firestore → Settings) once a reCAPTCHA key
// is set in js/analytics.js — validation alone cannot stop a determined
// scripter, it only stops a lazy one. See ANALYTICS.md.

service cloud.firestore {
  match /databases/{database}/documents {

    // string of at most n, or null — nearly every envelope value is this shape
    function sOrNull(v, n) {
      return v == null || (v is string && v.size() <= n);
    }
    function numOrNull(v) {
      return v == null || v is number;
    }

    function pageOk(p) {
      return p is map
        && p.keys().hasOnly(['path', 'title', 'referrer', 'host'])
        && sOrNull(p.get('path', null), 300)
        && sOrNull(p.get('title', null), 200)
        && sOrNull(p.get('referrer', null), 300)
        && sOrNull(p.get('host', null), 120);
    }

    function utmOk(u) {
      return u is map
        && u.keys().hasOnly(['source', 'medium', 'campaign', 'term', 'content'])
        && sOrNull(u.get('source', null), 120)
        && sOrNull(u.get('medium', null), 120)
        && sOrNull(u.get('campaign', null), 120)
        && sOrNull(u.get('term', null), 120)
        && sOrNull(u.get('content', null), 120);
    }

    function deviceOk(d) {
      return d is map
        && d.keys().hasOnly(['ua', 'lang', 'platform', 'mobile', 'tz',
                             'screenW', 'screenH', 'dpr', 'viewW', 'viewH'])
        && sOrNull(d.get('ua', null), 400)
        && sOrNull(d.get('lang', null), 20)
        && sOrNull(d.get('platform', null), 60)
        && d.get('mobile', false) is bool
        && sOrNull(d.get('tz', null), 60)
        && numOrNull(d.get('screenW', null)) && numOrNull(d.get('screenH', null))
        && numOrNull(d.get('dpr', null))
        && numOrNull(d.get('viewW', null)) && numOrNull(d.get('viewH', null));
    }

    // Structural guarantee, not a convention: no IP may ever be written. The
    // key pin makes an 'ip' field impossible; if someone later "just adds"
    // one, the write fails instead of quietly turning this into personal
    // data that needs a consent banner.
    // lat/lon are the map pins. analytics.js rounds them to one decimal — ~11km,
    // a city and not a street, so they say nothing the city name beside them
    // does not already say. The range check is what stops the field being
    // repurposed as a general-purpose number smuggler.
    function coordOk(v, limit) {
      return v == null || (v is number && v >= -limit && v <= limit);
    }

    function geoOk(g) {
      return g is map
        && g.keys().hasOnly(['country', 'countryName', 'region', 'city', 'tz',
                             'lat', 'lon'])
        && sOrNull(g.get('country', null), 8)
        && sOrNull(g.get('countryName', null), 80)
        && sOrNull(g.get('region', null), 120)
        && sOrNull(g.get('city', null), 120)
        && sOrNull(g.get('tz', null), 60)
        && coordOk(g.get('lat', null), 90)
        && coordOk(g.get('lon', null), 180);
    }

    function envelopeOk() {
      let d = request.resource.data;
      return d.schema is int && d.schema > 0 && d.schema <= 10
        // serverTimestamp() only — a client cannot backdate or forge an event
        && d.ts == request.time
        && sOrNull(d.get('clientTs', null), 40)
        && d.session is string && d.session.size() <= 64
        && sOrNull(d.get('product', null), 40)
        && pageOk(d.page) && utmOk(d.utm) && deviceOk(d.device) && geoOk(d.geo);
    }

    // Shared envelope keys every event carries.
    function envelopeKeys() {
      return ['schema', 'ts', 'clientTs', 'session', 'product',
              'page', 'utm', 'device', 'geo'];
    }

    function createOnly() {
      return request.method == 'create' && envelopeOk();
    }

    // ── reading ──────────────────────────────────────────────────────────
    //
    // Writing is public and unauthenticated because it has to be — a visitor's
    // browser does the writing. Reading is the opposite: these rows carry
    // coarse geo and user agents for real visitors, and nothing about that
    // should be fetchable by anyone who reads the page source.
    //
    // The dashboard reads live, so "no reads at all" is no longer an option.
    // This is the narrowest thing that still works: one named Google account,
    // checked server-side on every query. An API key alone gets you nothing —
    // request.auth is null and every read below is refused.
    //
    // Adding a second person is one more address in this list. Anything else
    // (a second project, a service account, an anonymous sign-in) is not
    // covered and stays refused.
    function dashboardReader() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['sheepdeklerk@gmail.com'];
    }

    // ── the public summary ───────────────────────────────────────────────
    //
    // One document, world-readable, holding the aggregated numbers the
    // dashboard draws. It exists for two reasons, and cost is the blunter one.
    //
    // Reading the raw collections costs one read per document per visitor. The
    // analytics passed 4,600 rows the day Bedroom Producers Blog linked the
    // site, so a shared dashboard would exhaust the free tier's 50k/day after
    // about ten views and go dark exactly when it got popular. This is one
    // read, however large the data grows.
    //
    // The other reason is that aggregates are the right thing to publish. The
    // raw rows carry a user agent, a city and a timestamp for every real
    // visitor; those people did not choose to be on a page whose code gets
    // passed around. tools/export.py --publish strips the per-visitor download
    // log before encrypting, and what lands here is ciphertext regardless.
    //
    // Writes stay closed to every browser identity — a world-readable document
    // on a public endpoint is otherwise a free billboard for whoever finds it.
    // Only project credentials (which bypass rules) can publish.
    match /public/{doc} {
      allow read: if true;
      allow write: if dashboardReader()
        && request.resource.data.keys().hasOnly(['json', 'generated', 'schema'])
        && request.resource.data.json is string
        && request.resource.data.json.size() < 900000;   // doc limit is 1 MiB
    }

    match /pageviews/{id} {
      allow create: if createOnly()
        && request.resource.data.keys().hasOnly(
             envelopeKeys().concat(['loadMs', 'entry']))
        && numOrNull(request.resource.data.get('loadMs', null))
        && request.resource.data.get('entry', false) is bool;
      allow read: if dashboardReader();
      allow update, delete: if false;
    }

    match /downloads/{id} {
      allow create: if createOnly()
        && request.resource.data.keys().hasOnly(
             envelopeKeys().concat(['asset', 'os', 'url', 'label',
                                    'placement', 'channel']))
        && request.resource.data.asset is string
        && request.resource.data.asset.size() <= 120
        && request.resource.data.os in ['macos', 'windows', 'linux', 'unknown']
        && sOrNull(request.resource.data.get('url', null), 400)
        && sOrNull(request.resource.data.get('label', null), 120)
        && sOrNull(request.resource.data.get('placement', null), 40)
        && request.resource.data.channel in ['github-releases', 'direct'];
      allow read: if dashboardReader();
      allow update, delete: if false;
    }

    match /clicks/{id} {
      allow create: if createOnly()
        && request.resource.data.keys().hasOnly(
             envelopeKeys().concat(['label', 'href', 'placement', 'kind']))
        && sOrNull(request.resource.data.get('label', null), 120)
        && sOrNull(request.resource.data.get('href', null), 400)
        && sOrNull(request.resource.data.get('placement', null), 40)
        && request.resource.data.kind in ['outbound', 'anchor', 'internal'];
      allow read: if dashboardReader();
      allow update, delete: if false;
    }

    // One summary row per visit, written on the way out — how long the page was
    // actually visible, how far down it was read, how many links were clicked.
    // Bounded hard: dwell cannot exceed a day and scroll is a fraction, so a
    // scripted row cannot inflate the averages without being obviously wrong.
    match /engagement/{id} {
      allow create: if createOnly()
        && request.resource.data.keys().hasOnly(
             envelopeKeys().concat(['dwellMs', 'maxScroll', 'clicks', 'section']))
        && request.resource.data.dwellMs is number
        && request.resource.data.dwellMs >= 0
        && request.resource.data.dwellMs <= 86400000
        && request.resource.data.maxScroll is number
        && request.resource.data.maxScroll >= 0
        && request.resource.data.maxScroll <= 1
        && request.resource.data.clicks is int
        && request.resource.data.clicks >= 0
        && request.resource.data.clicks <= 10000
        && sOrNull(request.resource.data.get('section', null), 60);
      allow read: if dashboardReader();
      allow update, delete: if false;
    }

    // ══════════════════════════════════════════════════════════════════
    // REMI DSP — Maine web suite (remidsp-maine.web.app)
    // Optional accounts: profiles, the cloud preset library, and the feed.
    // Same posture as the analytics rules above: key-pinned, size-capped.
    // ══════════════════════════════════════════════════════════════════

    function signedIn() {
      return request.auth != null;
    }

    // The avatar is stored inline on the document as a downscaled JPEG data
    // URI (src/ui/avatar.ts caps the encoder at 12000 chars). This ceiling is
    // the thing actually holding that line — the byline is denormalised onto
    // every preset and comment, so an unbounded string here would be copied
    // hundreds of times over.
    /* Where a picture may come from.
     *
     * Two shapes only:
     *   data:image/…  the inline fallback, capped at 12 kB because this string
     *                 is denormalised onto every preset and every comment.
     *   https://…     but ONLY on our own media origin.
     *
     * The host pin is the point. Any-https meant a player could set their
     * avatar to a URL on a server they control, and then every visitor who
     * scrolled past one of their comments would fetch it — handing that
     * player the IP address, and rough location, of everyone who reads the
     * feed. A tracking beacon anyone can install, in a field that looks like
     * decoration.
     *
     * Uploaded media is served by the share Worker at <origin>/m/<key>, never
     * straight off the bucket, so there is exactly ONE origin to pin.
     *
     * ── EDIT BOTH OF THESE TOGETHER AT DEPLOY TIME ──
     * MEDIA_PREFIX is the Worker origin plus '/m/'. MEDIA_PREFIX_LEN is its
     * length in characters. They are separate because rules have no way to
     * take a prefix of a dynamic length, and a mismatched pair fails CLOSED
     * (every uploaded picture is rejected), which is the safe direction.
     *
     * A slice comparison rather than matches(): in a regex an unescaped '.'
     * matches any character, so 'https://remi-share.workers.dev/' would also
     * accept a domain somebody could actually register. */
    // A url field that, if present, must be an ordinary https address. This
    // refuses javascript:, data: and http: outright — a capture link is
    // fetched by the browser and its scheme is not the author's to choose.
    // Written as a slice rather than a regex on purpose: getting a backslash
    // through a CEL string literal and into RE2 intact is a well-known way to
    // ship a rule that silently matches nothing.
    // '' counts as ABSENT. The clients write '' rather than omitting a field
    // (saveProfile sends `link: p.link ?? ''`), so a rule that only tolerated
    // null rejected every profile save the moment this was added. Optional
    // means optional in both spellings.
    function httpsOrNull(v) {
      return v == null || v == ''
        || (v is string && v.size() > 8 && v[0:8] == 'https://');
    }

    /* ── WHAT THIS USED TO DO, AND WHY IT DOES NOT ANY MORE ──
     *
     * This pinned avatarUrl to a data: URI or our own media origin, to close
     * the beacon described above. It also broke the entire product, and the
     * lesson is worth keeping in the file.
     *
     * A profile's avatar is not always ours to choose. ensureProfile() seeds
     * it from `user.photoURL`, which for a Google sign-in is a
     * lh3.googleusercontent.com URL, and the edit form has always offered
     * "…or paste an image url". Both are legitimate, both are remote, and
     * neither matches the pin.
     *
     * The blast radius was much wider than the profile, because avatarUrl is
     * DENORMALISED onto every preset and comment: presetShapeOk() calls
     * avatarOk() on that copy, and the preset UPDATE rule re-validates the
     * whole document — so a rejected avatar took saving a preset and sharing
     * to the feed down with it. One over-tight predicate, three broken
     * features, and nothing in the product could tell the player why.
     *
     * So: any https URL is accepted again, size-capped. The beacon stays open
     * and is tracked in docs/SOCIAL_PLAN.md. The real fix is not a stricter
     * predicate — it is to stop hotlinking third-party images at all: copy
     * the provider photo into R2 on first sign-in and store our own URL. Then
     * this pin becomes true by construction and can be reinstated safely. */
    function pictureOk(v, maxInline) {
      return v == null
        || v == ''
        || (v is string && v.size() <= maxInline && v[0:11] == 'data:image/')
        // a hosted image — ours, an identity provider's, or one the player
        // pasted. Length-capped so it can never be a payload.
        || (v is string && v.size() <= 500 && httpsOrNull(v));
    }
    function avatarOk(v) {
      return pictureOk(v, 12000);
    }

    // A handle is what will sit in a URL and an @mention: lowercase letters,
    // digits and underscore, starting with a letter. The doc id IS the
    // lowercased handle, which is where uniqueness actually comes from —
    // Firestore has no unique constraint, but it does have unique ids.
    function handleOk(h) {
      return h is string && h.size() >= 3 && h.size() <= 20
        && h.matches('^[a-z][a-z0-9_]*$');
    }
    // The profile may only carry a handle this player actually holds. Without
    // this, uniqueness would live entirely in client code and a crafted write
    // could take a name that is already someone's.
    function holdsHandle(h, uid) {
      return handleOk(h)
        && exists(/databases/$(database)/documents/usernames/$(h))
        && get(/databases/$(database)/documents/usernames/$(h)).data.uid == uid;
    }

    /* A cover is a banner: a hosted https URL, or one of the suite's own
     * drawn decks — 'deck:<name>', rendered entirely in CSS so it costs no
     * storage and no media origin. Never inline: 0 inline bytes allowed is
     * the whole point — a 200 kB data URI on a document this heavily
     * denormalised would be a disaster. */
    function coverOk(v) {
      return pictureOk(v, 0)
        || (v is string && v.size() <= 40 && v[0:5] == 'deck:');
    }

    function profileShapeOk() {
      let d = request.resource.data;
      return d.keys().hasOnly(
               ['username', 'usernameLower', 'bio', 'avatarUrl', 'coverUrl',
                'link', 'isPublic', 'pinnedId',
                'followersCount', 'followingCount', 'createdAt', 'updatedAt'])
        && d.username is string
        && d.username.size() >= 3 && d.username.size() <= 20
        && d.usernameLower == d.username.lower()
        && holdsHandle(d.usernameLower, request.auth.uid)
        && sOrNull(d.get('bio', null), 400)
        && (d.get('isPublic', true) is bool)
        && avatarOk(d.get('avatarUrl', null))
        && coverOk(d.get('coverUrl', null))
        && httpsOrNull(d.get('link', null))
        && sOrNull(d.get('link', null), 200)
        // The tone pinned to the top of the profile — an id, not a copy.
        && sOrNull(d.get('pinnedId', null), 40);
    }
    // Follow/unfollow rides a batched write that also creates/deletes the
    // follower's edge doc — the counter may move by exactly one.
    function followerBump() {
      let diff = request.resource.data.diff(resource.data);
      return signedIn()
        && diff.affectedKeys().hasOnly(['followersCount'])
        && (request.resource.data.followersCount - resource.data.get('followersCount', 0)) <= 1
        && (request.resource.data.followersCount - resource.data.get('followersCount', 0)) >= -1;
    }
    /* The username index.
     *
     * One document per taken handle, its id being the lowercased handle. That
     * id is the uniqueness guarantee: a create on an id that already exists
     * fails, so two players racing for the same free name cannot both win.
     * A rename is a delete plus a create inside one client transaction, which
     * is why update is closed — an update would let a handle change owner
     * without the old owner ever releasing it. */
    match /usernames/{handle} {
      // Readable by anyone: this is how "is it taken?" is answered before a
      // claim, and how a handle will resolve to a profile for a /u/<name>
      // route later. It holds a uid and nothing else.
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && handleOk(handle);
      // Release only what is yours.
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    match /profiles/{uid} {
      // Public by default; a player can hide the page. Docs written before
      // isPublic existed have no field, so absent reads as public — and
      // ensureProfile() backfills them on next sign-in, because searchUsers
      // filters on isPublic == true and an absent field matches nothing.
      // Feed bylines do NOT come through here: username and avatar are
      // denormalised onto each preset, so going private never blanks a
      // tone you chose to share.
      allow read: if resource.data.get('isPublic', true) == true
        || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid && profileShapeOk();
      allow update: if (signedIn() && request.auth.uid == uid && profileShapeOk())
        || followerBump();
      allow delete: if false;

      // Who {uid} follows — one edge doc per target, owned by {uid}.
      match /following/{targetUid} {
        allow read: if true;
        allow create, delete: if signedIn() && request.auth.uid == uid;
        allow update: if false;
      }

      /* ── notifications ─────────────────────────────────────────────────
       * "Somebody liked / commented / followed" — written by the ACTOR at
       * the moment they act, readable only by the player it is about. The
       * actor pin (actorUid == auth.uid) is what stops impersonation, and
       * kind is an enum so this can never become a general message channel:
       * messages have their own collection with their own gates. */
      match /notes/{noteId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn()
          && request.auth.uid != uid
          && request.resource.data.keys().hasOnly(
               ['kind', 'actorUid', 'actorName', 'toneId', 'toneName',
                'read', 'createdAt'])
          && request.resource.data.kind in ['like', 'comment', 'follow']
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.actorName is string
          && request.resource.data.actorName.size() >= 1
          && request.resource.data.actorName.size() <= 40
          && sOrNull(request.resource.data.get('toneId', null), 40)
          && sOrNull(request.resource.data.get('toneName', null), 60)
          && request.resource.data.read == false;
        // The owner may flip `read` and nothing else — a notification is a
        // record of something that happened, not an editable document.
        allow update: if signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow delete: if signedIn() && request.auth.uid == uid;
      }

      /* Who {uid} refuses messages from. Owner-only in every direction —
       * the blocked player is never told; their sends just stop landing.
       * (Rules' own exists() reads these server-side regardless.) */
      match /blocks/{blockedUid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create, delete: if signedIn() && request.auth.uid == uid;
        allow update: if false;
      }
    }

    /* ── wall posts ────────────────────────────────────────────────────────
     * Words on a profile that are not a preset: a question, a small win, a
     * "back after two weeks". A post may POINT AT one of the author's shared
     * tones (toneId), but it is never a copy of one — the wall is for the
     * person, the feed is for the sounds. Same posture as comments:
     * world-readable, author-deletable, never editable. */
    match /posts/{postId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
             ['uid', 'username', 'avatarUrl', 'text', 'toneId', 'toneName',
              'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 1
        && request.resource.data.username.size() <= 40
        && avatarOk(request.resource.data.get('avatarUrl', null))
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 600
        && sOrNull(request.resource.data.get('toneId', null), 40)
        && sOrNull(request.resource.data.get('toneName', null), 60);
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid == resource.data.uid;
    }

    /* ── messages ──────────────────────────────────────────────────────────
     * 1:1 only, and GATED ON MUTUAL FOLLOW: a thread can only be opened
     * between two players who each follow the other. That single rule is
     * most of the moderation story — a stranger cannot open your inbox, and
     * unfollowing closes the door to new threads. Blocks close it harder:
     * a message create checks the recipient's block list server-side.
     *
     * The thread id IS the membership: '<uidA>_<uidB>' with A < B, enforced
     * at create, so one pair of players can only ever have one thread and a
     * crafted id cannot claim members it does not name. */
    function follows(a, b) {
      return exists(/databases/$(database)/documents/profiles/$(a)/following/$(b));
    }
    function dmOther(threadId) {
      let parts = threadId.split('_');
      return parts[0] == request.auth.uid ? parts[1] : parts[0];
    }

    match /dms/{threadId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
             ['members', 'names', 'avatars', 'lastText', 'lastUid', 'lastAt',
              'reads', 'createdAt'])
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members[0] < request.resource.data.members[1]
        && threadId == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && follows(request.resource.data.members[0], request.resource.data.members[1])
        && follows(request.resource.data.members[1], request.resource.data.members[0])
        && !exists(/databases/$(database)/documents/profiles/$(dmOther(threadId))/blocks/$(request.auth.uid))
        && request.resource.data.names is map
        && request.resource.data.avatars is map
        && request.resource.data.get('lastText', '') is string
        && request.resource.data.get('lastText', '').size() <= 200
        && request.resource.data.reads is map;
      // Members may move the conversation surface — last line, read marks,
      // refreshed bylines — but membership itself is immutable.
      allow update: if signedIn() && request.auth.uid in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['lastText', 'lastUid', 'lastAt', 'reads', 'names', 'avatars'])
        && request.resource.data.get('lastText', '') is string
        && request.resource.data.get('lastText', '').size() <= 200;
      allow delete: if false;

      match /messages/{msgId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/dms/$(threadId)).data.members;
        allow create: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/dms/$(threadId)).data.members
          && request.resource.data.keys().hasOnly(['uid', 'text', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 1000
          && !exists(/databases/$(database)/documents/profiles/$(dmOther(threadId))/blocks/$(request.auth.uid));
        allow update: if false;
        allow delete: if signedIn() && request.auth.uid == resource.data.uid;
      }
    }

    function presetShapeOk() {
      let d = request.resource.data;
      return d.keys().hasOnly(
               ['uid', 'username', 'avatarUrl', 'name', 'amp', 'voice', 'params', 'capture',
                'shared', 'description', 'likesCount', 'commentsCount',
                'downloadsCount', 'createdAt', 'updatedAt'])
        && d.uid == request.auth.uid
        && d.username is string && d.username.size() <= 40
        && avatarOk(d.get('avatarUrl', null))
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 60
        && d.amp is string && d.amp.size() <= 30
        && d.voice is string && d.voice.size() <= 40
        && d.params is map
        // The params map is the rig's knob positions and nothing else. The cap
        // stops a 1 MB blob riding along on a document the feed pulls thirty of.
        //
        // What is NOT enforced here, and cannot be: that every VALUE is a
        // number. Rules have no iteration and a map's values cannot be
        // type-tested as a set, so the only expressible version would be to
        // enumerate all 107 params — which would then reject every save the
        // day a param is added. That check therefore lives at the render site
        // instead (src/ui/feed.ts, the g() accessor plus a per-card try), where
        // a bad value costs one unrendered card rather than the whole feed.
        && d.params.size() <= 200
        && (d.capture == null
            || (d.capture is map && d.capture.keys().hasOnly(
                  ['source', 'label', 'stem', 'modelId', 'modelUrl',
                   'creator', 'license', 'toneUrl'])
                && d.capture.source in ['bundled', 'tone3000']
                // EVERY string here is rendered on somebody else's screen, and
                // until now only modelUrl was checked at all — label and
                // creator could be any type and any length, which is what let
                // a shared tone carry markup into the capture gate's innerHTML.
                // The client escapes them now; this is the second lock.
                && sOrNull(d.capture.get('label', null), 120)
                && sOrNull(d.capture.get('stem', null), 80)
                && sOrNull(d.capture.get('modelId', null), 80)
                && sOrNull(d.capture.get('creator', null), 80)
                && sOrNull(d.capture.get('license', null), 120)
                && sOrNull(d.capture.get('toneUrl', null), 500)
                && sOrNull(d.capture.get('modelUrl', null), 500)
                && httpsOrNull(d.capture.get('modelUrl', null))
                && httpsOrNull(d.capture.get('toneUrl', null))))
        && d.shared is bool
        && d.description is string && d.description.size() <= 500
        && d.likesCount is int && d.commentsCount is int && d.downloadsCount is int;
    }

    // Counter bumps by other people: likes/comments ride batched writes that
    // also touch the like/comment doc; downloads may come from anyone.
    function likeBump() {
      let diff = request.resource.data.diff(resource.data);
      return signedIn()
        && diff.affectedKeys().hasOnly(['likesCount'])
        && (request.resource.data.likesCount - resource.data.likesCount) <= 1
        && (request.resource.data.likesCount - resource.data.likesCount) >= -1;
    }
    function commentBump() {
      let diff = request.resource.data.diff(resource.data);
      return signedIn()
        && diff.affectedKeys().hasOnly(['commentsCount'])
        && (request.resource.data.commentsCount - resource.data.commentsCount) == 1;
    }
    function downloadBump() {
      let diff = request.resource.data.diff(resource.data);
      return diff.affectedKeys().hasOnly(['downloadsCount'])
        && (request.resource.data.downloadsCount - resource.data.downloadsCount) == 1;
    }

    match /presets/{presetId} {
      allow read: if resource.data.shared == true
        || (signedIn() && request.auth.uid == resource.data.uid);
      allow create: if signedIn() && presetShapeOk()
        && request.resource.data.likesCount == 0
        && request.resource.data.commentsCount == 0
        && request.resource.data.downloadsCount == 0;
      allow update: if (signedIn() && request.auth.uid == resource.data.uid
                        && presetShapeOk())
        || likeBump() || commentBump() || downloadBump();
      allow delete: if signedIn() && request.auth.uid == resource.data.uid;

      match /likes/{likerUid} {
        allow read: if true;
        allow create, delete: if signedIn() && request.auth.uid == likerUid;
        allow update: if false;
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(
               ['uid', 'username', 'avatarUrl', 'presetName', 'text', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.username is string
          && request.resource.data.username.size() <= 40
          && avatarOk(request.resource.data.get('avatarUrl', null))
          && sOrNull(request.resource.data.get('presetName', null), 60)
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 500;
        allow update: if false;
        allow delete: if signedIn() && request.auth.uid == resource.data.uid;
      }
    }

    // Collection-group reads for a player's comment history (comments are
    // public under their presets already; this lets the profile page query
    // them across presets in one go).
    match /{path=**}/comments/{commentId} {
      allow read: if true;
    }

    // Everything else is closed. (This is already the default; stated so the
    // intent survives the next person editing this file.)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
